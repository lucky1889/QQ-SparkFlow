APP_ROOT=/opt/qq-sparkflow
TZ=Asia/Shanghai

WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8787
SPARKFLOW_SESSION_COOKIE_SECURE=0

# One-command install asks for / generates these values.
QQ_ACCOUNT_COUNT=1
DEFAULT_SEND_TIME=10:00
ONEBOT_ACCESS_TOKEN=

# Optional mainland-China pip mirror for faster image builds.
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# Optional Debian mirror for faster apt-get during image builds.
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
